# Copy to .env for local development. Never commit real secrets.
VAIBHAV_ENV=local
VAIBHAV_DATABASE_URL=mysql+asyncmy://vaibhav:vaibhav@127.0.0.1:3306/vaibhav?charset=utf8mb4
VAIBHAV_REDIS_URL=redis://127.0.0.1:6379/0
VAIBHAV_CORS_ORIGINS=http://localhost:3000
# Required (>=32 chars) outside local/test:
# VAIBHAV_JWT_SECRET=
# VAIBHAV_HASH_PEPPER=
# Local only: show the OTP on screen instead of sending an SMS.
VAIBHAV_OTP_DEBUG_ECHO=true
# The web BFF forwards the visitor IP; trust exactly one proxy hop.
VAIBHAV_TRUSTED_PROXY_COUNT=1
